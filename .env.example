# ============================================================================
# Variaveis de ambiente para rf-uau-automation
# ============================================================================
# INSTRUCOES:
#   1. Copie este arquivo para .env  ->  cp .env.example .env
#   2. Preencha os valores reais no .env
#   3. NUNCA commite o .env no Git
# ============================================================================

# --- Credenciais UauXT (obrigatorio) ---
UAUXT_USUARIO=Root
UAUXT_SENHA=sua_senha_aqui

# --- Caminhos de instalacao ---
UAUXT_EXE=C:/UAU_AUTOMACAO20.0/Modulos/UauXT.exe
COMPILADOR_DIR=C:/ProjetosTFS/UAU/10.06/Producao/Componentes
COMPILADOR_PASTA_SAIDA=C:/UAU/UAU 10.06/Modulos
VS_EXE=C:/Program Files (x86)/Microsoft Visual Studio/2019/Professional/Common7/IDE/devenv.exe

# --- Configuracoes TFVC ---
TFS_SERVIDOR=NomeDoServidor
TFS_PROJETO=NomeDoProjeto
TFS_BRANCH=10.06
TFS_PASTA_ALVO=Producao

# --- Configuracoes de API REST ---
# URL base unica para os testes de API
API_BASE_URL=https://httpbin.org

# Endpoint padrao de health/check
API_HEALTH_PATH=/status/200

# Endpoint de autenticacao corporativa
API_AUTH_PATH=/api/v1/Autenticador/AutenticarUsuarioCorporativo

# Timeout padrao para requests (segundos)
API_TIMEOUT=30

# TLS: manter false em uso normal. Use true apenas para diagnostico local.
API_TLS_INSECURE=false

# Caminho opcional para CA bundle corporativo (.pem), quando necessario.
API_CA_BUNDLE=

# Header padrao de autenticacao da Globaltec (x-auth)
API_X_AUTH=

# Token globaltec retornado no endpoint de autenticacao
API_TOKEN_GLOBALTEC=

# Credenciais do payload de autenticacao corporativa
API_LOGIN_AD=
API_SENHA=
API_LOGIN_UAU=
